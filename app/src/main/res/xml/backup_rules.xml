<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Retra keeps Android Auto Backup intentionally compact so save recovery is
      less likely to hit the platform quota. Once explicit include rules are
      present Android treats this file as an allowlist, so unlisted ROM, BIOS,
      cache, temporary and working directories remain excluded automatically.
    -->
    <include domain="file" path="persistent_data/" />
    <include domain="file" path="datastore/" />
    <include domain="database" path="." />
    <include domain="sharedpref" path="retra_library.xml" />
</full-backup-content>
