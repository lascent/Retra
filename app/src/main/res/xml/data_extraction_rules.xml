<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Explicit includes form the portable Retra backup allowlist. -->
        <include domain="file" path="persistent_data/" />
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="retra_library.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Device transfer uses the same portable-data boundary. -->
        <include domain="file" path="persistent_data/" />
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="retra_library.xml" />
    </device-transfer>
</data-extraction-rules>
