<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- User data is portable; copyrighted ROM binaries and transient files are not. -->
        <exclude domain="file" path="library_content/" />
        <exclude domain="file" path="save_work/" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfer follows the same data-safety boundary. -->
        <exclude domain="file" path="library_content/" />
        <exclude domain="file" path="save_work/" />
    </device-transfer>
</data-extraction-rules>
