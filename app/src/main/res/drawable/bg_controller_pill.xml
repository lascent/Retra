<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7045525A" />
            <stroke android:width="1.4dp" android:color="#F8FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5211171D" />
            <stroke android:width="1.4dp" android:color="#BFFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
